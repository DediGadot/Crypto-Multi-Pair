            f.write("</div>\n\n")
        else:
            f.write("<p>None found</p>\n\n")

        f.write("<h3>❌ TIER 3: DOES NOT BEAT BUY-AND-HOLD</h3>\n")
        if underperformed:
            f.write("<p>🚫 These strategies <strong>NEVER</strong> beat buy-and-hold on any time horizon<br>\n")
            f.write("<strong>NOT RECOMMENDED</strong> for trading - use buy-and-hold instead</p>\n\n")

            f.write("<table>\n")
            f.write("    <thead>\n")
            f.write("        <tr>\n")
            f.write("            <th>Rank</th><th>Strategy</th><th>Avg Return</th><th>Sharpe</th><th>Drawdown</th><th>Won</th>\n")
            f.write("        </tr>\n")
            f.write("    </thead>\n")
            f.write("    <tbody>\n")

            for rank, strat in enumerate(underperformed, 1):
                f.write(f"        <tr class='tier3'>\n")
                f.write(f"            <td>{rank}</td>\n")
                f.write(f"            <td><strong>{strat.strategy_name}</strong></td>\n")
                f.write(f"            <td>{HTMLReportWriter.format_percentage(strat.avg_return)}</td>\n")
                f.write(f"            <td>{HTMLReportWriter.format_number(strat.avg_sharpe)}</td>\n")
                f.write(f"            <td>{HTMLReportWriter.format_percentage(strat.avg_max_drawdown, with_sign=False)}</td>\n")
                f.write(f"            <td>{strat.horizons_beat_buyhold}/{strat.total_horizons}</td>\n")
                f.write(f"        </tr>\n")

            f.write("    </tbody>\n")
            f.write("</table>\n\n")

            f.write("<div class='blockquote info'>\n")
            f.write("    <p>💡 Even if returns are positive, buy-and-hold performed better.</p>\n")
            f.write("</div>\n\n")
        else:
            f.write("<p>None found</p>\n\n")

        f.write("<h3>👤 RECOMMENDATIONS BY INVESTOR PROFILE</h3>\n")
        f.write("<div class='profile-section'>\n")

        def _html_pick_with_fallback(primary, fallback, key, reverse=False):
            pool = primary if primary else fallback
            return (sorted(pool, key=key, reverse=reverse)[0] if pool else None)

        eligible_for_risk_html = beat_buyhold + close_to_buyhold
        if not eligible_for_risk_html:
            eligible_for_risk_html = strategy_scores

        aggressive_pick_html = _html_pick_with_fallback(
            beat_buyhold,
            strategy_scores,
            key=lambda x: x.avg_return,
            reverse=True
        )

        conservative_candidates_html = [s for s in eligible_for_risk_html if np.isfinite(s.avg_max_drawdown)]
        if not conservative_candidates_html:
            conservative_candidates_html = strategy_scores

        conservative_pick_html = _html_pick_with_fallback(
            conservative_candidates_html,
            strategy_scores,
            key=lambda x: (x.avg_max_drawdown, -x.avg_return)
        )
        if conservative_pick_html and aggressive_pick_html and conservative_pick_html.strategy_name == aggressive_pick_html.strategy_name:
            alternatives = [s for s in conservative_candidates_html if s.strategy_name != aggressive_pick_html.strategy_name]
            if alternatives:
                conservative_pick_html = min(alternatives, key=lambda x: (x.avg_max_drawdown, -x.avg_return))

        balanced_candidates_html = [s for s in eligible_for_risk_html if np.isfinite(s.avg_sharpe)]
        if not balanced_candidates_html:
            balanced_candidates_html = strategy_scores

        balanced_pick_html = _html_pick_with_fallback(
            balanced_candidates_html,
            strategy_scores,
            key=lambda x: x.avg_sharpe,
            reverse=True
        )
        restricted_names_html = {pick.strategy_name for pick in (aggressive_pick_html, conservative_pick_html) if pick}
        if balanced_pick_html and balanced_pick_html.strategy_name in restricted_names_html:
            alternatives = [s for s in balanced_candidates_html if s.strategy_name not in restricted_names_html]
            if alternatives:
                balanced_pick_html = max(alternatives, key=lambda x: x.avg_sharpe)

        def _render_profile_card(title: str, description: str, pick: Optional[StrategyScore], trailing: str) -> None:
            f.write("    <div class='profile-card'>\n")
            f.write(f"        <h4>{title}</h4>\n")
            f.write(f"        <p><em>{description}</em></p>\n")
            if pick:
                f.write(f"        <p><strong>→ {pick.strategy_name}</strong></p>\n")
                f.write(f"        <p>Returns: {HTMLReportWriter.format_percentage(pick.avg_return, with_sign=False)} | {trailing}</p>\n")
            else:
                f.write("        <p><strong>→ Buy-and-hold</strong> (no active strategies beat benchmark)</p>\n")
            f.write("    </div>\n")

        trailing_aggressive = "Drawdown: " + HTMLReportWriter.format_percentage(
            aggressive_pick_html.avg_max_drawdown, with_sign=False
        ) if aggressive_pick_html else "Drawdown: N/A"
        trailing_conservative = "Drawdown: " + HTMLReportWriter.format_percentage(
            conservative_pick_html.avg_max_drawdown, with_sign=False
        ) if conservative_pick_html else "Drawdown: N/A"
        trailing_balanced = "Sharpe: " + HTMLReportWriter.format_number(
            balanced_pick_html.avg_sharpe
        ) if balanced_pick_html else "Sharpe: N/A"

        _render_profile_card(
            "🎯 AGGRESSIVE INVESTOR",
            "Maximize returns, accept high risk",
            aggressive_pick_html,
            trailing_aggressive
        )
        _render_profile_card(
            "🛡️ CONSERVATIVE INVESTOR",
            "Minimize drawdown, accept lower returns",
            conservative_pick_html,
            trailing_conservative
        )
        _render_profile_card(
            "⚖️ BALANCED INVESTOR",
            "Best risk-adjusted returns",
            balanced_pick_html,
            trailing_balanced
        )

        f.write("</div>\n\n")
