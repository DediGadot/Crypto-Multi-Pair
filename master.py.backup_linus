                f.write(f"            <td>{HTMLReportWriter.format_percentage(strat.avg_max_drawdown, with_sign=False)}</td>\n")
                f.write(f"            <td>{strat.horizons_beat_buyhold}/{strat.total_horizons}</td>\n")
                f.write(f"        </tr>\n")

            f.write("    </tbody>\n")
            f.write("</table>\n\n")

            best = beat_buyhold[0]
            f.write("<div class='recommendation-box'>\n")
